{
    "name": "tinymvc/skeleton",
    "type": "project",
    "description": "TinyMvc is a minimalist PHP framework to craft blazing-fast RESTful APIs and modern web apps.",
    "keywords": ["shahinmoyshan", "tinymvc", "tinycore", "mvc", "web framework", "php framework", "framework"],
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "tinymvc/tinycore": "^4.3"
    },
    "authors": [
        {
            "name": "Shahin Moyshan",
            "email": "shahin.moyshan2@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "suggest": {
        "phpmailer/phpmailer": "Required for sending emails (^6.9).",
        "league/commonmark": "Required to use Str::markdown() and Stringable::markdown() (^2.6).",
        "voku/portable-ascii": "Required to use on Str::slug() with non-english strings (^2.0).,",
        "ramsey/uuid": "Required to use Str::uuid() (^4.7).",
        "ext-curl": "Required for the HTTP client.",
        "ext-fileinfo": "Required for upload and file MIME detection.",
        "ext-gd": "Required for image manipulation.",
        "ext-pdo_sqlite": "Required when the database connection uses SQLite.",
        "ext-redis": "Required for Redis cache, lock, session, and queue drivers."
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-autoload-dump": [
            "@php spark package:discover --ansi"
        ],
         "post-update-cmd": [
            "@php spark vendor:publish --tag=spark-assets --ansi --force"
        ],
        "post-create-project-cmd": [
            "@php spark key:generate --ansi",
            "@php spark migrate --ansi"
        ],
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php spark key:generate",
            "@php spark migrate --force",
            "npm install  --ignore-scripts",
            "npm run build"
        ],
        "test": "@php test"
    },
    "config": {
        "optimize-autoloader": true
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
